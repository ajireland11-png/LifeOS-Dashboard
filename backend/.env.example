# SQLite database path used by the Rust backend.
#
# This is intentionally different from the root .env's DATABASE_URL. The
# root one is relative to the project root, since that's where Prisma's
# CLI always runs from (`bun run db:generate`, `db:migrate`, etc). This
# one is relative to `backend/`, since that's where the backend process
# actually runs from (see the `backend:dev` script) — one level up gets
# you to the same prisma/dev.db file the root .env points at.
DATABASE_URL=file:../prisma/dev.db

# Optional: override the port the backend listens on (defaults to 8080).
# PORT=8080
