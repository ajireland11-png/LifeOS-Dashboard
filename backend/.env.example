# SQLite database path used by the Rust backend.
#
# This is intentionally different from the root .env's DATABASE_URL. The
# root one is relative to the project root, since that's where Prisma's
# CLI always runs from (`bun run db:generate`, `db:migrate`, etc). This
# one is relative to `backend/`, since that's where the backend process
# actually runs from (see the `backend:dev` script) — one level up gets
# you to the same prisma/dev.db file the root .env points at.
DATABASE_URL=file:../prisma/dev.db

# Optional: override the port the backend listens on (defaults to 8080).
# PORT=8080

# Scientific Paper Interpreter. Default mode is local deterministic extraction; no AI key or API charge.
PAPER_INTERPRETER_MODE=deterministic

# Optional local model-assisted interpretation using Ollama (no per-request API fee).
# Install Ollama separately, download a model, then set:
# PAPER_INTERPRETER_MODE=ollama
# PAPER_INTERPRETER_MODEL=llama3.1
# PAPER_INTERPRETER_OLLAMA_URL=http://127.0.0.1:11434/v1/chat/completions

# Optional hosted model-assisted interpretation (may incur charges).
# PAPER_INTERPRETER_MODE=openai
# OPENAI_API_KEY=your-key-here
# PAPER_INTERPRETER_MODEL=gpt-4.1
