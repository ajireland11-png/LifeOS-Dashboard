// Life OS - Personal Life Operating System
// Comprehensive database schema for all modules

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// CORE MODELS
// ============================================

model UserProfile {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  avatar       String?
  timezone     String   @default("UTC")
  locale       String   @default("en")
  theme        String   @default("system")
  setupComplete Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  settings     Settings?
}

model Settings {
  id              String   @id @default(cuid())
  userId          String   @unique
  sidebarCollapsed Boolean @default(false)
  defaultView     String   @default("dashboard")
  weekStartsOn    Int      @default(1)
  dateFormat      String   @default("yyyy-MM-dd")
  timeFormat      String   @default("24h")
  currency        String   @default("USD")
  notificationsEnabled Boolean @default(true)
  backupEnabled   Boolean  @default(false)
  backupFrequency String   @default("weekly")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// WORKSPACE & WIDGETS
// ============================================

model Workspace {
  id          String   @id @default(cuid())
  name        String
  description String?
  icon        String?
  color       String?
  isDefault   Boolean  @default(false)
  layout      String?  // JSON string for widget positions
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  widgets     Widget[]
}

model Widget {
  id          String   @id @default(cuid())
  workspaceId String
  type        String   // task-summary, calendar, habit-tracker, note-quick, finance-summary, etc.
  title       String
  config      String?  // JSON string for widget-specific config
  positionX   Int      @default(0)
  positionY   Int      @default(0)
  width       Int      @default(4)
  height      Int      @default(3)
  visible     Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ============================================
// TAGS (polymorphic - used across modules)
// ============================================

model Tag {
  id          String   @id @default(cuid())
  name        String
  color       String   @default("#6b7280")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  taskTags    TaskTag[]
  noteTags    NoteTag[]
  journalTags JournalTag[]
  goalTags    GoalTag[]
  habitTags   HabitTag[]
  bookmarkTags BookmarkTag[]
}

// ============================================
// TASK MANAGEMENT
// ============================================

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("todo") // todo, in-progress, done, cancelled
  priority    String   @default("medium") // low, medium, high, urgent
  dueDate     DateTime?
  startDate   DateTime?
  completedAt DateTime?
  estimatedMinutes Int?
  actualMinutes    Int?
  recurrence  String? // none, daily, weekly, monthly, custom
  recurrenceConfig String? // JSON for custom recurrence
  position    Int      @default(0)
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projectId   String?
  parentTaskId String?

  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parentTask  Task?     @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks    Task[]    @relation("TaskSubtasks")
  tags        TaskTag[]
  dependencies TaskDependency[] @relation("TaskDependent")
  dependents  TaskDependency[] @relation("TaskDependsOn")
  timeEntries TimeEntry[]
  calendarEvents CalendarEvent[]
  pomodoroSessions PomodoroSession[]
}

model TaskTag {
  id     String @id @default(cuid())
  taskId String
  tagId  String

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([taskId, tagId])
}

model TaskDependency {
  id           String @id @default(cuid())
  taskId       String // The task that depends on another
  dependsOnId  String // The task being depended on

  task         Task   @relation("TaskDependent", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn    Task   @relation("TaskDependsOn", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("#6b7280")
  icon        String?
  status      String   @default("active") // active, on-hold, completed, cancelled
  startDate   DateTime?
  endDate     DateTime?
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks       Task[]
  goals       GoalProject[]
}

// ============================================
// KNOWLEDGE MANAGEMENT (Second Brain)
// ============================================

model Note {
  id          String   @id @default(cuid())
  title       String
  content     String   @default("")
  type        String   @default("note") // note, article, reference, idea, daily-note
  icon        String?
  color       String?
  isPinned    Boolean  @default(false)
  isFavorite  Boolean  @default(false)
  wordCount   Int      @default(0)
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  folderId    String?
  folder      NoteFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  tags        NoteTag[]
  links       NoteLink[] @relation("NoteSource")
  backlinks   NoteLink[] @relation("NoteTarget")
  bookmarks   Bookmark[]
}

model NoteFolder {
  id          String   @id @default(cuid())
  name        String
  icon        String?
  color       String?
  parentId    String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent      NoteFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    NoteFolder[] @relation("FolderHierarchy")
  notes       Note[]
}

model NoteTag {
  id     String @id @default(cuid())
  noteId String
  tagId  String

  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([noteId, tagId])
}

model NoteLink {
  id         String @id @default(cuid())
  sourceNoteId String
  targetNoteId String

  source     Note   @relation("NoteSource", fields: [sourceNoteId], references: [id], onDelete: Cascade)
  target     Note   @relation("NoteTarget", fields: [targetNoteId], references: [id], onDelete: Cascade)

  @@unique([sourceNoteId, targetNoteId])
}

model Bookmark {
  id          String   @id @default(cuid())
  url         String
  title       String
  description String?
  favicon     String?
  noteId      String?

  note        Note?   @relation(fields: [noteId], references: [id], onDelete: SetNull)
  tags        BookmarkTag[]
  createdAt   DateTime @default(now())
}

model BookmarkTag {
  id         String @id @default(cuid())
  bookmarkId String
  tagId      String

  bookmark   Bookmark @relation(fields: [bookmarkId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([bookmarkId, tagId])
}

// ============================================
// GOALS
// ============================================

model Goal {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String   @default("personal") // personal, career, health, financial, education, social
  status      String   @default("not-started") // not-started, in-progress, completed, abandoned
  progress    Int      @default(0) // 0-100
  startDate   DateTime?
  targetDate  DateTime?
  completedAt DateTime?
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parentGoalId String?
  parentGoal   Goal?     @relation("GoalSubgoals", fields: [parentGoalId], references: [id], onDelete: Cascade)
  subgoals     Goal[]    @relation("GoalSubgoals")
  tags         GoalTag[]
  milestones   Milestone[]
  projects     GoalProject[]
}

model GoalTag {
  id     String @id @default(cuid())
  goalId String
  tagId  String

  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([goalId, tagId])
}

model Milestone {
  id          String   @id @default(cuid())
  goalId      String
  title       String
  completed   Boolean  @default(false)
  completedAt DateTime?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

model GoalProject {
  id        String @id @default(cuid())
  goalId    String
  projectId String

  goal      Goal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([goalId, projectId])
}

// ============================================
// HABITS
// ============================================

model Habit {
  id          String   @id @default(cuid())
  name        String
  description String?
  icon        String?
  color       String   @default("#6b7280")
  frequency   String   @default("daily") // daily, weekly, custom
  frequencyConfig String? // JSON for custom frequency
  targetCount Int      @default(1)
  unit        String?
  reminderEnabled Boolean @default(false)
  reminderTime    String?
  /// Number of consecutive missed days that don't break the streak.
  /// 0 = strict (default), 1 = forgive a single missed day, etc.
  gapForgiveness  Int     @default(0)
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tags        HabitTag[]
  logs        HabitLog[]
}

model HabitTag {
  id      String @id @default(cuid())
  habitId String
  tagId   String

  habit   Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([habitId, tagId])
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  date      DateTime
  count     Int      @default(1)
  note      String?
  createdAt DateTime @default(now())

  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
}

// ============================================
// JOURNAL
// ============================================

model JournalEntry {
  id          String   @id @default(cuid())
  title       String?
  content     String   @default("")
  mood        String?  // amazing, good, okay, bad, terrible
  moodScore   Int?     // 1-5
  energy      Int?     // 1-5
  stress      Int?     // 1-5
  gratitude   String?  // JSON array of gratitude items
  tags        String?  // comma-separated tags (for quick entry)
  isFavorite  Boolean  @default(false)
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entryTags   JournalTag[]
}

model JournalTag {
  id       String @id @default(cuid())
  entryId  String
  tagId    String

  entry    JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tag      Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([entryId, tagId])
}

// ============================================
// FINANCE
// ============================================

model FinanceAccount {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("checking") // checking, savings, credit, cash, investment, loan
  balance     Float    @default(0)
  currency    String   @default("USD")
  color       String?
  icon        String?
  isDefault   Boolean  @default(false)
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions Transaction[]
}

model TransactionCategory {
  id          String   @id @default(cuid())
  name        String
  icon        String?
  color       String   @default("#6b7280")
  type        String   @default("expense") // income, expense, transfer
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions Transaction[]
  budgetItems  BudgetItem[]
}

model Transaction {
  id          String   @id @default(cuid())
  amount      Float
  description String
  type        String   @default("expense") // income, expense, transfer
  date        DateTime
  note        String?
  isRecurring Boolean  @default(false)
  recurrence  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  accountId      String
  categoryId     String?
  transferToId   String?

  account        FinanceAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category       TransactionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
}

model Budget {
  id          String   @id @default(cuid())
  name        String
  period      String   @default("monthly") // weekly, monthly, yearly
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       BudgetItem[]
}

model BudgetItem {
  id          String   @id @default(cuid())
  budgetId    String
  categoryId  String
  amount      Float
  spent       Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  budget      Budget             @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category    TransactionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

// ============================================
// LEARNING
// ============================================

model Course {
  id          String   @id @default(cuid())
  title       String
  description String?
  provider    String?  // Udemy, Coursera, YouTube, Book, etc.
  url         String?
  status      String   @default("not-started") // not-started, in-progress, completed, paused
  progress    Int      @default(0) // 0-100
  startDate   DateTime?
  endDate     DateTime?
  rating      Int?     // 1-5
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  resources   CourseResource[]
}

model CourseResource {
  id          String   @id @default(cuid())
  courseId     String
  title       String
  type        String   @default("video") // video, article, book, podcast, exercise
  url         String?
  completed   Boolean  @default(false)
  notes       String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

// ============================================
// CALENDAR & TIME
// ============================================

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime?
  allDay      Boolean  @default(false)
  color       String   @default("#6b7280")
  location    String?
  recurrence  String?
  recurrenceConfig String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  taskId      String?

  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
}

model TimeEntry {
  id          String   @id @default(cuid())
  description String
  startTime   DateTime
  endTime     DateTime?
  duration    Int?     // minutes
  billable    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  taskId      String?

  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
}

model PomodoroSession {
  id          String   @id @default(cuid())
  type        String   @default("focus") // focus, short-break, long-break
  duration    Int      // actual duration in seconds
  completed   Boolean  @default(false)
  taskId      String?
  startedAt   DateTime @default(now())
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
}

// ============================================
// ATLAS — personal knowledge graph
// ============================================
// A generic edge between any two records in the system (a Note, Project,
// Task, Goal, Habit, Bookmark, JournalEntry or Course). Deliberately NOT
// modelled as a foreign key to any one table, since an edge can point at
// any entity type — sourceType/targetType + id is the polymorphic pair.
//
// `kind` distinguishes how the edge came to exist, per the Atlas design:
//   - "connected"  — the user explicitly drew this relationship (only kind
//                    writable through the API today)
//   - "observed"   — derived at read time from real data (e.g. two things
//                    sharing a tag); never stored as a row
//   - "inferred"   — reserved for a future pass that spots patterns across
//                    multiple observations
//   - "suggested"  — reserved for a future pass that proposes a possible
//                    connection for the user to confirm or dismiss
// ============================================
// ATLAS — connective knowledge layer
// ============================================
// These are deliberately lightweight, first-class intellectual objects.
// They are not forced into tasks/projects. A question can remain a question,
// an inspiration can remain an inspiration, and a concept can connect many
// papers, notes, projects and experiments through AtlasConnection.
model KnowledgeItem {
  id        String   @id @default(cuid())
  type      String   // question, concept, paper, idea, inspiration, skill, thing, place
  title     String
  summary   String?
  content   String   @default("")
  sourceUrl String?
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([archived])
  @@index([updatedAt])
}

model AtlasConnection {
  id         String   @id @default(cuid())
  sourceType String
  sourceId   String
  targetType String
  targetId   String
  kind       String   @default("connected")
  label      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([sourceType, sourceId, targetType, targetId, kind])
  @@index([sourceType, sourceId])
  @@index([targetType, targetId])
}

// ============================================
// EXPLORE — knowledge subjects (field-guide layer)
// ============================================
// A first slice of Explore: a subject you're building understanding of.
// Deliberately plain for now (title, summary, free-form content) — the
// richer structure from the brief (diagrams, references, related subjects,
// experiments) is intentionally left for a later pass rather than guessed
// at here.
model ExploreSubject {
  id        String   @id @default(cuid())
  title     String
  summary   String?
  content   String   @default("")
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// STUDIO — inspiration, ideas, and things you might make
// ============================================
// An item deliberately does not need to become a task or project — per the
// brief, an inspiration item is allowed to just stay an inspiration item.
// `kind` is a loose, user-typed label (e.g. "idea", "inspiration",
// "material", "technique") rather than a fixed enum, since the brief
// explicitly favours discovery over rigid categorisation.
model StudioItem {
  id        String   @id @default(cuid())
  title     String
  kind      String   @default("idea")
  summary   String?
  content   String   @default("")
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


// ============================================
// RESEARCH — papers as living laboratory objects
// ============================================
// A paper is deliberately modular: prose, questions, interpretation,
// figures and tables can be edited independently in the Research room.
// Figure images are stored as data URLs for the local-first prototype.
model ResearchPaper {
  id              String   @id @default(cuid())
  title           String
  authors         String?
  journal         String?
  year            Int?
  doi             String?
  sourceUrl       String?
  abstract        String?
  scientificQuestion String?
  background      String?
  mechanisms      String?
  interpretation  String?
  limitations     String?
  openQuestions   String?
  notes           String?
  figuresJson     String   @default("[]")
  tablesJson      String   @default("[]")
  archived        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([archived])
  @@index([updatedAt])
}
